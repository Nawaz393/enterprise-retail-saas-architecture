        ORDER[Order / Checkout]
        PAYMENT[Payment]
        COMMISSION[Commission]
        AUDIT[Audit]
    end
    subgraph Infrastructure["Infrastructure"]
        DB[(PostgreSQL)]
        QUEUE[(Queue)]
        STORAGE[Object Storage]
        PROVIDER[Payment Provider]
    end
    CTRL --> AUTH
    CTRL --> ORDER
    ORDER --> CART
    ORDER --> PRICE
    ORDER --> CATALOG
    ORDER --> PAYMENT
    ORDER --> COMMISSION
